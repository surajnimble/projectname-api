# ─── Runtime ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=projectname
LOG_LEVEL=info

# ─── Database (PostgreSQL) ─────────────────────────────
# Production / Render Postgres — use the EXTERNAL database URL, because the
# internal hostname only resolves from inside Render's private network.
#   DATABASE_URL="postgresql://USER:PASS@dpg-xxxx-xxxx.<region>-postgres.render.com:5432/DB?schema=public&connection_limit=5"
#
# Local without Docker — `npm run db:up` starts PGlite (real Postgres, WASM):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://testing_fw52_user:CHANGE_ME@dpg-dav03c142hec73boe2bg-a.singapore-postgres.render.com:5432/testing_fw52?schema=public&connection_limit=5"

# ─── Redis ─────────────────────────────────────────────
# Local (docker compose up redis): redis://127.0.0.1:6379
# Production (Upstash):           rediss://default:<password>@<endpoint>.upstash.io:6379
# Leave empty to run without Redis — cache and rate limiting degrade gracefully.
REDIS_URL=
REDIS_PREFIX=projectname

# ─── JWT ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Super Admin seed ──────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@projectname.com
SUPER_ADMIN_PASSWORD=SuperSecret@123

# ─── CORS (whitelist — comma separated, no wildcard) ───
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Encryption (AES-256-GCM) ──────────────────────────
ENCRYPTION_ENABLED=false
# 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Cloudinary ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=projectname

# ─── SMTP (transactional email) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=ProjectName
MAIL_FROM_EMAIL=no-reply@projectname.com

# ─── Push (FCM) ────────────────────────────────────────
FCM_SERVER_KEY=
FCM_ENABLED=false

# ─── Payments (optional) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Shipping partners ─────────────────────────────────
SHIPPING_PARTNER_WEBHOOK_SECRET=

# ─── BullMQ / Redis queue ──────────────────────────────
# Requires REDIS_URL. Set false to run without background jobs.
QUEUE_ENABLED=false
QUEUE_PREFIX=projectname
WORKER_ENABLED=false

# ─── Tracking / Analytics ──────────────────────────────
TRACKING_ENABLED=true
GEO_LOOKUP_ENABLED=true

# ─── Rate limiting ─────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Local PGlite (scripts/db.ts) ──────────────────────
# Only relevant when DATABASE_URL points at the local PGlite bridge.
PGLITE_PORT=5432
PGLITE_HOST=127.0.0.1
PGLITE_DATA_DIR=pglite-data
# true  -> serialise Prisma queries (the bridge serves one connection)
# false -> normal pooling, required for a real PostgreSQL server
PGLITE_MODE=false

# ─── Seed ──────────────────────────────────────────────
SEED_DEMO_DATA=true