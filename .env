# ---------------------------------------------------------------- Runtime
NODE_ENV=development
PORT=5000
APP_NAME=projectname
LOG_LEVEL=warn

# ---------------------------------------------------------------- Database
# Render Postgres (external URL - this is the one that works from your machine).
# The "internal" hostname only resolves from inside Render's private network.
DATABASE_URL="postgresql://testing_fw52_user:mDe6irYgneJFi6P6QaZfFEtGdYppjSLM@dpg-dav03c142hec73boe2bg-a.singapore-postgres.render.com:5432/testing_fw52?schema=public&connection_limit=5"

# ---------------------------------------------------------------- Redis (optional)
# Leave empty to run without Redis: cache is skipped and rate limiting falls
# back to in-process counters. Required for BullMQ jobs and realtime analytics.
REDIS_URL=
REDIS_PREFIX=projectname

# ---------------------------------------------------------------- JWT
# Generate real secrets for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=local-dev-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=local-dev-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------------------------------------------------------------- Super Admin
SUPER_ADMIN_EMAIL=superadmin@projectname.com
SUPER_ADMIN_PASSWORD=SuperSecret@123

# ---------------------------------------------------------------- CORS
# Whitelist only - never a wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- Encryption
# 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=

# ---------------------------------------------------------------- Background jobs
# Both need REDIS_URL.
QUEUE_ENABLED=false
WORKER_ENABLED=false

# ---------------------------------------------------------------- Local PGlite
# Only used by `npm run db:up`. Set true only when DATABASE_URL points at the
# local PGlite bridge; it serialises queries because that bridge serves one
# connection. Keep it false against a real PostgreSQL server.
PGLITE_PORT=5432
PGLITE_HOST=127.0.0.1
PGLITE_DATA_DIR=pglite-data
PGLITE_MODE=false

# ---------------------------------------------------------------- Seed
SEED_DEMO_DATA=true