# .env — YOUR REAL VALUES. Do NOT share or commit this file if the repo is public.
# Template with empty values: .env.example
#
# Change something? Edit .env, restart the server (npm run dev), and run "npm run doctor" to check it.


# ======================================================================
#  1. MUST FILL — app will not start without these
# ======================================================================
# Your PostgreSQL connection string.
# On Render  -> use the INTERNAL database URL.
# On your PC -> use the EXTERNAL database URL (the internal one does not work from your PC).
DATABASE_URL=postgresql://projectnamedb_user:oVbNvJjECJqIlq1Lr1ci3WL2syfE6xxI@dpg-db0tug6gekts73b9aj6g-a.singapore-postgres.render.com:5432/projectnamedb?schema=public&connection_limit=5
# Two secret keys used to sign login tokens. Minimum 16 characters, and they must be different.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If you change them, everyone gets logged out.
JWT_ACCESS_SECRET=5dc4d14b9c7b88bf621f493837e8e9a76ff7180385e34048bcf46edf8e9410ff233180b63097b00dc451920f4360e53b
JWT_REFRESH_SECRET=2c018ec590462a6e2b3ebdcd6430d3831a4e731a14dc9ec44584a64cb3c14422075dc021d39433418f1e104f1807c813
# How long a login token lasts (access / refresh). Default: 15m / 7d.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ======================================================================
#  2. BASIC APP SETTINGS
# ======================================================================
# development | test | production.  Use "production" on Render.
NODE_ENV=development
# Server port. Render sets it automatically. Default: 5000.
PORT=5000
# Public address of this API (used by the Swagger docs "Try it out" button).
# Local: leave empty.  Render: https://your-service.onrender.com/api/v1
PUBLIC_API_URL=https://projectname-api.onrender.com
# App name. Also used inside login tokens - changing it logs everyone out.
APP_NAME=projectname
# How much to print in logs: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# ======================================================================
#  3. OTP (verification codes)
# ======================================================================
# true  = users must verify an OTP to register / log in (safe, default).
# false = no OTP at all (only for testing, never for live).
OTP_REQUIRED=true
# true = also send OTP by SMS (needs MSG91 settings below). Default: false.
OTP_SMS_ENABLED=false
# Fixed OTP for local testing (every OTP becomes this number).
# MUST be empty on Render / production, otherwise the app will not start.
OTP_STATIC_CODE=111111

# ======================================================================
#  4. EMAIL — optional (you can skip this while building)
#  No email settings = no mail is sent, the OTP is just printed in the terminal.
# ======================================================================
# Option A: Brevo (300 free emails/day). Used first if filled.
BREVO_API_KEY=
# Sender address. Must be a verified sender in Brevo.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ProjectName
# Option B: any SMTP email server (used only if Brevo key is empty).
SMTP_HOST=
SMTP_PORT=587
# true only for port 465. For port 587 keep false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Name and address people see in the "From" of the email.
MAIL_FROM_NAME=ProjectName
MAIL_FROM_EMAIL=no-reply@projectname.com

# ======================================================================
#  5. SMS (MSG91) — optional
#  In India you need a DLT-approved sender ID and template (the template must contain {{0}} for the code).
# ======================================================================
MSG91_AUTHKEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91

# ======================================================================
#  6. IMAGES / FILES (Cloudinary)
#  Render deletes files on every restart, so uploads go to Cloudinary. Empty = upload routes return 503.
# ======================================================================
# Get these from Cloudinary -> Settings -> API Keys (use the main "Root" key).
CLOUDINARY_CLOUD_NAME=dt8hnsz29
CLOUDINARY_API_KEY=876234191881745
CLOUDINARY_API_SECRET=sHo6OHYgGwGujC21Jf9IzPPpi9M
# Main folder name in your Cloudinary library.
CLOUDINARY_FOLDER=projectname

# ======================================================================
#  7. REDIS + BACKGROUND JOBS — optional
#  No Redis? Keep QUEUE_ENABLED=false and WORKER_ENABLED=false, otherwise the app will not start.
# ======================================================================
# Redis connection URL (Render Key Value, Upstash or Redis Cloud). Empty = no Redis.
REDIS_URL=
# Name tags so many apps can share one Redis.
REDIS_PREFIX=projectname
QUEUE_PREFIX=projectname
# true = run background jobs (needs Redis). Default: true.
QUEUE_ENABLED=false
# true = this server also runs the jobs. Turn on for ONE server only. Default: true.
WORKER_ENABLED=false

# ======================================================================
#  8. CORS — which websites may call this API
#  Comma separated, no spaces, no trailing slash, no "*". Empty in production = every website is blocked.
# ======================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# For chat / live updates. Empty = uses CORS_ORIGINS.
SOCKET_CORS_ORIGINS=

# ======================================================================
#  9. SUPER ADMIN (created by "npm run seed")
# ======================================================================
SUPER_ADMIN_EMAIL=superadmin@projectname.com
# Default password is unsafe - change it before going live.
# It is only used the first time you seed; changing it later does not change the saved password.
SUPER_ADMIN_PASSWORD=SuperSecret@123

# ======================================================================
#  10. PERFORMANCE & SECURITY SWITCHES
# ======================================================================
# true = track devices/sessions (adds 2 database queries per request). Default: true.
TRACKING_ENABLED=true
# true = find country/city from IP. Default: true.
GEO_LOOKUP_ENABLED=true
# true = limit too many requests (also protects OTP). Keep true.
RATE_LIMIT_ENABLED=true
# true = encrypt request/response bodies (client must support it). Default: false.
ENCRYPTION_ENABLED=false
# Needed only if encryption is on. Exactly 64 hex characters, never change it later.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=5e3aa85f501e61f73af87674864dd38aecc2ce29470326fd58560f7d6977c039

# ======================================================================
#  11. LOCAL DATABASE (PGlite) — only for "npm run db:up", never on Render
# ======================================================================
PGLITE_PORT=5432
PGLITE_HOST=127.0.0.1
PGLITE_DATA_DIR=pglite-data
# Keep false when DATABASE_URL points to a real PostgreSQL.
PGLITE_MODE=false
# true = "npm run seed" also adds demo vendors, products and coupons.
SEED_DEMO_DATA=true

# ======================================================================
#  12. NOT USED YET — safe to ignore
#  Reserved for future payment / shipping / push features. Filling them changes nothing today.
# ======================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
SHIPPING_PARTNER_WEBHOOK_SECRET=
FCM_SERVER_KEY=
FCM_ENABLED=false