{
  "version": 2,
  "name": "projectname-api",

  /**
   * Route every request to the Vercel serverless function in api/index.ts.
   * The Express app mounts all routes under /api/v1 internally, so the path
   * is preserved as-is. There are no static assets in this API-only project,
   * so a catch-all route is safe.
   */
  "routes": [
    { "src": "/(.*)", "dest": "api/index.ts" }
  ],

  /**
   * Environment variables exposed to the function at runtime. Secrets
   * (DATABASE_URL, JWT_*_SECRET, REDIS_URL, SUPER_ADMIN_PASSWORD, API keys)
   * must be set in the Vercel project dashboard under Settings → Environment
   * Variables and marked as "Secret" so they are never stored in this file.
   */
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "APP_NAME": "projectname",
    "LOG_LEVEL": "info",

    "OTP_REQUIRED": "true",
    "OTP_SMS_ENABLED": "false",
    "OTP_STATIC_CODE": "",

    "QUEUE_ENABLED": "false",
    "WORKER_ENABLED": "false",
    "QUEUE_PREFIX": "projectname",

    "TRACKING_ENABLED": "true",
    "GEO_LOOKUP_ENABLED": "true",
    "RATE_LIMIT_ENABLED": "true",
    "ENCRYPTION_ENABLED": "false",

    "PGLITE_MODE": "false",
    "SEED_DEMO_DATA": "false"
  },

  /**
   * Scheduled jobs on Vercel replace the in-process cron that ran inside the
   * Cloudflare Container. Each cron invokes an HTTP endpoint on this API.
   *
   * NOTE: These endpoints do not exist in the codebase yet. Before enabling
   * them, create route handlers (for example under src/modules/system/) that
   * perform the same work the BullMQ jobs did (cleanup, analytics rollup,
   * payout cycle, auto-cancel unpaid orders, etc.) without BullMQ.
   *
   * Disabled by default — uncomment and add the endpoints when you are ready.
   */
  "crons": [
    // { "path": "/api/v1/cron/cleanup-expired", "schedule": "0 0 * * *" },
    // { "path": "/api/v1/cron/analytics-rollup", "schedule": "0 1 * * *" },
    // { "path": "/api/v1/cron/payout-cycle", "schedule": "0 2 * * *" },
    // { "path": "/api/v1/cron/auto-cancel-unpaid", "schedule": "*/30 * * * *" },
    // { "path": "/api/v1/cron/lift-expired-bans", "schedule": "0 3 * * *" },
    // { "path": "/api/v1/cron/refresh-customer-segments", "schedule": "0 4 * * *" },
    // { "path": "/api/v1/cron/price-drop-scan", "schedule": "0 5 * * *" },
    // { "path": "/api/v1/cron/token-reminder", "schedule": "0 6 * * *" },
    // { "path": "/api/v1/cron/prune-failed-jobs", "schedule": "0 7 * * *" }
  ]
}
